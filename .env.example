# ==============================================================================
# CENTRIOR — Variáveis de Ambiente
# ==============================================================================

# Para desenvolvimento local com SQLite em arquivo:
DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

# Para produção ou desenvolvimento com Turso (LibSQL Serverless):
# DATABASE_URL="libsql://your-database-slug.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# Base URL da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Chave Criptográfica de Sessão (Mínimo 32 bytes / 64 hex chars)
BETTER_AUTH_SECRET="generate-with-crypto-randomBytes-32-hex"

# E-mail Transacional (Resend)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="Centrior <onboarding@resend.dev>"


